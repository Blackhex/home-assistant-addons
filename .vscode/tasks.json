{
  "inputs": [
    {
      "args": "http://localhost:8123",
      "command": "simpleBrowser.api.open",
      "id": "openHomeAssistant",
      "type": "command"
    },
    {
      "args": "http://localhost:3481",
      "command": "simpleBrowser.api.open",
      "id": "openOpodsync",
      "type": "command"
    },
    {
      "args": "http://localhost:8085",
      "command": "simpleBrowser.api.open",
      "id": "openFDroid",
      "type": "command"
    }
  ],
  "tasks": [
    {
      "command": ": '${input:openHomeAssistant}'",
      "dependsOn": [
        "Home Assistant/Restore Snapshot",
        "Home Assistant/Await Core"
      ],
      "dependsOrder": "sequence",
      "label": "Home Assistant/Open in Browser",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "type": "shell"
    },
    {
      "command": "docker inspect -f '{{.State.Status}}' hassio_supervisor 2>/dev/null | grep -q running || supervisor_run",
      "group": "test",
      "label": "Home Assistant/Start Supervisor",
      "presentation": {
        "panel": "new",
        "reveal": "always"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/await-core.sh\"",
      "label": "Home Assistant/Await Core",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/ha-snapshot.sh\" restore",
      "label": "Home Assistant/Restore Snapshot",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/ha-snapshot.sh\" capture",
      "group": "test",
      "label": "Home Assistant/Capture Snapshot",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/install-app.sh\" local_opodsync",
      "group": "test",
      "label": "Apps/oPodSync/Install",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/install-app.sh\" local_fdroid",
      "group": "test",
      "label": "Apps/F-Droid/Install",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/start-app.sh\" local_opodsync",
      "group": "test",
      "label": "Apps/oPodSync/Start",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/rebuild-app.sh\" local_opodsync",
      "group": "test",
      "label": "Apps/oPodSync/Rebuild",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/rebuild-app.sh\" local_fdroid",
      "group": "test",
      "label": "Apps/F-Droid/Rebuild",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/start-app.sh\" local_fdroid && : '${input:openFDroid}'",
      "group": "test",
      "label": "Apps/F-Droid/Start",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/uninstall-app.sh\" local_opodsync",
      "group": "test",
      "label": "Apps/oPodSync/Uninstall",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "bash \"${workspaceFolder}/.devcontainer/uninstall-app.sh\" local_fdroid",
      "group": "test",
      "label": "Apps/F-Droid/Uninstall",
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "label": "Build/Template",
      "type": "shell",
      "command": ".vscode\\build-addon.ps1 template @('BUILD_FROM=ghcr.io/home-assistant/amd64-base:latest', 'REPO_URL=https://github.com/Blackhex/firefly-iii.git')",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Build/Firefly III",
      "type": "shell",
      "command": ".vscode\\build-addon.ps1 firefly-iii",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Build Firefly III Dev",
      "type": "shell",
      "command": "docker build --build-arg BUILD_FROM=\"ghcr.io/hassio-addons/base/amd64:stable\" -t firefly-iii-dev firefly-iii-dev",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Run Firefly III Dev",
      "type": "shell",
      "command": "docker run --rm firefly-iii-dev",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Build Angular",
      "type": "shell",
      "command": "docker build --build-arg BUILD_FROM=\"ghcr.io/hassio-addons/base/amd64:stable\" -t angular-hello-addon angular-hello-addon",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Build/Firefly III Dev",
      "type": "shell",
      "command": "docker build --build-arg BUILD_FROM=\"ghcr.io/hassio-addons/base/amd64:stable\" -t firefly-iii-dev firefly-iii-dev",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Build/Angular",
      "type": "shell",
      "command": "docker build --build-arg BUILD_FROM=\"ghcr.io/hassio-addons/base/amd64:stable\" -t angular-hello-addon angular-hello-addon",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    },
    {
      "label": "Run/Firefly III Dev",
      "type": "shell",
      "command": "docker run --rm firefly-iii-dev",
      "group": "build",
      "presentation": {
        "panel": "shared"
      }
    }
  ],
  "version": "2.0.0"
}
